<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 1. Deshabilitar WebSocket nativo de IIS para que ARR los reenvíe a Node.js / PM2 -->
    <webSocket enabled="false" />

    <!-- 2. Tamaño máximo de carga (50MB) para Excel, adjuntos y reportes -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" maxQueryString="32768" />
      </requestFiltering>
    </security>

    <!-- 3. Pasar intactos los errores JSON de las APIs de Node (evita pantallas de error genéricas de IIS) -->
    <httpErrors existingResponse="PassThrough" />

    <!-- 4. Reglas de Ruteo y Proxy Reverso -->
    <rewrite>
      <rules>

        <!-- ================================================================= -->
        <!-- REGLA DE SEGURIDAD: FORZAR HTTPS ÚNICAMENTE PARA /ecns            -->
        <!-- Las demás aplicaciones (liionMES, validaciones) pueden usar HTTP  -->
        <!-- ================================================================= -->
        <rule name="ForceHttpsOnlyForEcns" stopProcessing="true">
          <match url="^ecns(/.*)?$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- ================================================================= -->
        <!-- APP 1: liionMES (Puerto 3000)                                     -->
        <!-- ================================================================= -->
        <rule name="ProxyApiApp1" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://localhost:3000/api/{R:1}" />
        </rule>

        <rule name="ProxyToApp1" stopProcessing="true">
          <match url="^liionMES(/.*)?$" />
          <action type="Rewrite" url="http://localhost:3000/liionMES{R:1}" />
        </rule>

        <!-- ================================================================= -->
        <!-- APP 2: ECN Manager (Puerto 3001) - Tráfico HTTPS                  -->
        <!-- NOTA: IIS termina el SSL en el puerto 443 y reenvía internamente  -->
        <!-- a http://localhost:3001 con el header X-Forwarded-Proto: https   -->
        <!-- ================================================================= -->
        <rule name="ProxyToApp2_ECNS" stopProcessing="true">
          <match url="^ecns(/.*)?$" />
          <action type="Rewrite" url="http://localhost:3001/ecns{R:1}" />
        </rule>

        <!-- ================================================================= -->
        <!-- APP 3: Validaciones (Puerto 3002 / 3003) - Tráfico HTTP / HTTPS   -->
        <!-- ================================================================= -->
        <rule name="ProxyToApp3_Validaciones" stopProcessing="true">
          <match url="^validaciones(/.*)?$" />
          <action type="Rewrite" url="http://localhost:3002/validaciones{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <!-- 5. Encabezados de seguridad para HTTPS -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
